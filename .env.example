# Copy this file to .env and fill in real values. .env is gitignored - never commit it.
# Used by tools/send_email.py (invoked by /submit) to send a drafted application by email.

# SMTP server. Default below is Outlook/Microsoft 365.
# For a Gmail account instead, use smtp.gmail.com (port 587).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# Your sending mailbox. For Outlook with 2FA enabled (the normal case), you cannot use
# your regular account password over SMTP - generate an app password instead:
#   https://account.microsoft.com -> Security -> Advanced security options -> App passwords
# For Gmail: https://myaccount.google.com -> Security -> App passwords (requires 2FA on).
SMTP_USER=you@outlook.com
SMTP_PASSWORD=your-app-password

# Optional: display name shown in the From header, e.g. "Jane Doe <you@outlook.com>"
SMTP_FROM_NAME=
